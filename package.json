{
  "name": "solo-leveling",
  "version": "1.1.0",
  "description": "Веб-приложение для прокачки навыков и тренировки памяти в стиле «Поднятие уровня в одиночку»",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
